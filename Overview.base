filters:
  and:
    - file.hasProperty("tags")
    - '!file.inFolder("Templates")'
formulas:
  TODO: tags.containsAny("todo", "untried")
properties:
  file.name:
    displayName: Recipe
  file.folder:
    displayName: Category
  formula.TODO:
    displayName: TODO
views:
  - type: table
    name: All Recipes
    order:
      - file.folder
      - file.name
      - Cook Time
      - Course
      - Unusual Ingredients
      - formula.TODO
      - Vegan
    sort:
      - property: file.folder
        direction: ASC
      - property: formula.TODO
        direction: DESC
      - property: file.name
        direction: ASC
    columnSize:
      file.folder: 220
      file.name: 349
      note.Cook Time: 316
      note.Course: 242
      note.Unusual Ingredients: 535
  - type: table
    name: Mains
    filters:
      and:
        - Course.contains("main")
    order:
      - file.folder
      - file.name
      - Cook Time
      - Course
      - Unusual Ingredients
      - formula.TODO
      - Vegan
    sort:
      - property: file.folder
        direction: ASC
      - property: formula.TODO
        direction: DESC
      - property: file.name
        direction: ASC
    columnSize:
      file.folder: 220
      file.name: 349
      note.Cook Time: 316
      note.Course: 242
      note.Unusual Ingredients: 535
  - type: table
    name: Desserts
