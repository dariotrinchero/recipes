        direction: DESC
      - property: file.name
        direction: ASC
    columnSize:
      file.folder: 220
      file.name: 349
      note.Cook Time: 316
      note.Course: 242
      note.Unusual Ingredients: 535
  - type: table
    name: Sides
    filters:
      and:
        - Course.contains("side")
    order:
      - file.folder
      - file.name
      - Cook Time
      - Course
      - Unusual Ingredients
      - formula.TODO
      - Vegan
    sort:
      - property: file.folder
        direction: ASC
      - property: formula.TODO
        direction: DESC
      - property: file.name
        direction: ASC
    columnSize:
      file.folder: 220
      file.name: 349
      note.Cook Time: 316
      note.Course: 242
      note.Unusual Ingredients: 535
  - type: table
    name: Starters
    filters:
      and:
        - Course.contains("starter")
    order:
      - file.folder
      - file.name
      - Cook Time
      - Course
      - Unusual Ingredients
      - formula.TODO
      - Vegan
    sort:
      - property: file.folder
        direction: ASC
      - property: formula.TODO
        direction: DESC
      - property: file.name
        direction: ASC
    columnSize:
      file.folder: 220
      file.name: 349
      note.Cook Time: 316
      note.Course: 242
      note.Unusual Ingredients: 535
